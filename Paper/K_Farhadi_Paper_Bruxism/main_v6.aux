\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces RQ1. The EMG filter chain is the only thing that varies: the same 6,173 windows, the same five outer-fold assignments and the same labels in every arm, verified window by window across the two prediction ledgers. Residual mains power is the share of 20--450-Hz power within $\pm 3$~Hz of a mains multiple, averaged over participant $\times $ class cells; a perfectly white signal would score 0.098. ``Inv.'' counts participant pairs in which one person's resting EMG exceeded another person's active EMG. Differences quoted in the text are computed before rounding.}}{12}{table.3}\protected@file@percent }
\newlabel{tab:filter}{{3}{12}{RQ1. The EMG filter chain is the only thing that varies: the same 6,173 windows, the same five outer-fold assignments and the same labels in every arm, verified window by window across the two prediction ledgers. Residual mains power is the share of 20--450-Hz power within $\pm 3$~Hz of a mains multiple, averaged over participant $\times $ class cells; a perfectly white signal would score 0.098. ``Inv.'' counts participant pairs in which one person's resting EMG exceeded another person's active EMG. Differences quoted in the text are computed before rounding}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The mains-harmonic defect, in the terms a classification paper is read in. (a) Residual mains power for every candidate chain implemented and measured, against the 0.098 a white signal would score; the chain used is the lowest, and was chosen on this axis rather than on classification score. (b) Screening macro-F1 per held-out participant before and after the correction, on the 28 EMG features and identical folds. (c) The mechanism: each activity's median RMS divided by that participant's own resting RMS, five participants per condition, before (down triangles) and after (up triangles). (d) Between-participant amplitude spread, and the number of pairs in which one person's resting EMG exceeded another's active EMG. No panel reads the microphone.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:measurement_chain}{{5}{12}{The mains-harmonic defect, in the terms a classification paper is read in. (a) Residual mains power for every candidate chain implemented and measured, against the 0.098 a white signal would score; the chain used is the lowest, and was chosen on this axis rather than on classification score. (b) Screening macro-F1 per held-out participant before and after the correction, on the 28 EMG features and identical folds. (c) The mechanism: each activity's median RMS divided by that participant's own resting RMS, five participants per condition, before (down triangles) and after (up triangles). (d) Between-participant amplitude spread, and the number of pairs in which one person's resting EMG exceeded another's active EMG. No panel reads the microphone}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Five-class performance on the corrected signal. The upper block gives participant-level means---computed within each held-out participant, then averaged over the five---so its rows are directly comparable; the lower block gives per-class values on pooled held-out windows, averaged over three seeds, with one-vs-rest AUC computed from held-out probabilities. Values describe this five-participant dataset and are not population-level superiority tests.}}{13}{table.4}\protected@file@percent }
\newlabel{tab:results}{{4}{13}{Five-class performance on the corrected signal. The upper block gives participant-level means---computed within each held-out participant, then averaged over the five---so its rows are directly comparable; the lower block gives per-class values on pooled held-out windows, averaged over three seeds, with one-vs-rest AUC computed from held-out probabilities. Values describe this five-participant dataset and are not population-level superiority tests}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces One-vs-rest ROC (left) and precision--recall (right) curves for the five classes, pooled over the held-out windows of seed 0 (the lowest seed index, a fixed rule rather than a post-hoc choice). Each curve depicts one trained model per fold, so legend values are that seed's; three-seed means are in Table~\ref {tab:results}. Precision--recall separates the classes far more sharply than ROC, because it is sensitive to the very unequal class sizes.}}{13}{figure.6}\protected@file@percent }
\newlabel{fig:roc_pr}{{6}{13}{One-vs-rest ROC (left) and precision--recall (right) curves for the five classes, pooled over the held-out windows of seed 0 (the lowest seed index, a fixed rule rather than a post-hoc choice). Each curve depicts one trained model per fold, so legend values are that seed's; three-seed means are in Table~\ref {tab:results}. Precision--recall separates the classes far more sharply than ROC, because it is sensitive to the very unequal class sizes}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Five-class performance for each held-out participant, averaged over three seeds.}}{13}{table.5}\protected@file@percent }
